# Line endings are normalised to LF in the repository and on checkout.
#
# Commits are made from SourceTree on Windows over \\wsl$; without this, CRLF
# leaks into the working tree and every tracked file shows as modified with an
# empty diff, which hides real changes rather than merely being untidy.
* text=auto eol=lf

# Binary assets — never touched, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.ttf  binary
*.woff  binary
*.woff2 binary

# Development-only files. Kept out of `git archive` output (GitHub's "Download
# ZIP", and Packagist dist archives for repos that are published there).
#
# This does NOT cover the XenForo release zip - that is built by
# xf-addon:build-release, which walks the filesystem and knows nothing about
# git. These files are named in build.json's rm line as well, and both are
# needed.
/CLAUDE.md        export-ignore
/CLAUDE.local.md  export-ignore
/TESTING.md       export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
